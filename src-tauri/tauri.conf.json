{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claude Notify",
  "version": "0.1.0",
  "identifier": "com.claude-notify.app",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claude Notify",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "visible": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png"
    ]
  }
}
