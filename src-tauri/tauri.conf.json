{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Claudar",
  "version": "0.4.9",
  "identifier": "com.avr.claudar",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Claudar",
        "width": 400,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "center": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "deb", "appimage", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBQzU4NkQwRUU3NjA5RjkKUldUNUNYYnUwSWJGMm5lc3llZ3hOeURFSkFlajBVeHhOM3ZRU21WMVBvb1hnTnZYUXViYkZGU1YK",
      "endpoints": [
        "https://github.com/kingsyy/claudar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
